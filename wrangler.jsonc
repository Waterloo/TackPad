{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tackpad-scratch",
  "main": "./.output/server/index.mjs",
  "compatibility_date":"2026-02-27",
  "compatibility_flags": ["nodejs_compat"],

  "placement": { "mode": "smart" },
  "upload_source_maps": true,

  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },

  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },

  // D1 Database binding
  "d1_databases": [
    {
      "binding": "tackpad_db",
      "database_name": "tackpad-scratch",
      "database_id": "2ab27075-9bd2-4f38-bfcc-0653e8989afb",
      "migrations_dir": "server/db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "TACKPAD_ASSETS",
      "bucket_name": "tackpad-scratch-assets",
      "preview_bucket_name": "tackpad-scratch-assets",
      "remote": true
    }
  ]
}
