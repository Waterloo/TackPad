{
  "name": "tackpad-scratch",
  "packageManager": "pnpm@10.29.3",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate-local": "wrangler d1 migrations apply tackpad-db --local",
    "db:migrate-prod": "wrangler d1 migrations apply tackpad-db --remote",
    "deploy": "nuxt build --preset=cloudflare-module && wrangler deploy"
  },
  "dependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.15.1",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.2.1",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "0.13.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@primevue/nuxt-module": "^4.5.4",
    "@primevue/themes": "^4.5.4",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/suggestion": "^3.20.0",
    "@tiptap/vue-3": "^3.20.0",
    "@vueuse/core": "^14.2.1",
    "drizzle-orm": "^0.45.1",
    "nanoid": "^5.1.6",
    "nuxt": "^4.3.1",
    "nuxt-auth-utils": "^0.5.29",
    "perfect-freehand": "^1.2.3",
    "pinia": "^3.0.4",
    "primevue": "^4.5.4",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4",
    "wavesurfer.js": "^7.12.1",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260227.0",
    "@tailwindcss/typography": "^0.5.19",
    "drizzle-kit": "^0.31.9",
    "nitro-cloudflare-dev": "^0.2.2",
    "tailwindcss": "^3.4.19",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.67.0"
  }
}
